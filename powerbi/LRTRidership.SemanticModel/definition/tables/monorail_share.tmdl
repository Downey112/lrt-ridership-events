table monorail_share
	lineageTag: 3227f359-f0aa-5a50-9cf8-672b0c72f827

	measure 'Monorail Share' = AVERAGE ( monorail_share[share] )
		formatString: 0.0%
		displayFolder: Base
		lineageTag: 18b5c1ab-3039-5472-8207-9ec531c07537

	column month
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 4db24862-a01f-52b4-bbb5-20490ecccb6b
		summarizeBy: none
		sourceColumn: month

	column share
		dataType: double
		formatString: 0.0%
		lineageTag: d81a5bfc-cb2b-50fe-b013-e17822d8ea9e
		summarizeBy: none
		sourceColumn: share

	partition monorail_share = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\monorail_share.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {
				        {"month", type date},
				        {"share", type number}
				    }, "en-US")
				in
				    Typed
