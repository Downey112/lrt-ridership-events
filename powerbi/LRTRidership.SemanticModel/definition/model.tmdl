model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder", "lines", "events", "event_effects", "event_daily", "monthly", "recovery_monthly", "my50_context", "line_recovery"]

annotation PBI_ProTooling = ["DevMode"]

ref table lines
ref table events
ref table event_effects
ref table event_daily
ref table monthly
ref table recovery_monthly
ref table my50_context
ref table line_recovery
