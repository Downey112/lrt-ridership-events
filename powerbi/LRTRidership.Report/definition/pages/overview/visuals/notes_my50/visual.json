            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "What changed riders?",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#101828"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Free fares did: +19% to +34% on three lines in Jun–Jul 2022, and LRT Shah Alam lost 4 in 10 weekday riders when its free rides ended.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#101828"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Disruptions moved riders: the Monorail gained 16% while Kelana Jaya was shut.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#101828"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "My50 still can't be measured from this data.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#101828"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Photo: Kelana Jaya Line LRT Train by Anthonytyc, Wikimedia Commons, CC BY-SA 4.0 (cropped, darkened). Independent analysis, not affiliated with Prasarana or Rapid KL.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "7pt",
                      "color": "#5B6475"
                    }
                  }
                ]
              }
            ]
          }
