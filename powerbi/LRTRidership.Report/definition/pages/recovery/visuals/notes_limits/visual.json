    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Limits",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#101828"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "My50 can't be measured: it began as COVID rules eased, and there is no line without it to compare.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#101828"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The free month started the same day MRT Putrajaya Phase 1 opened, so part of its effect may be the new line feeding others.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#101828"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "'Not robust' = ridership was already rising just before the event, so the jump may not be the event's.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#101828"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "School holidays and Selangor-only holidays are not in the model. Monorail at ~175% of 2019 may partly reflect counting changes; not checked.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#101828"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Data: ridership_headline, data.gov.my (Prasarana / Ministry of Transport).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#5B6475"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Photo: Kelana Jaya Line LRT Train by Anthonytyc, Wikimedia Commons, CC BY-SA 4.0 (cropped, darkened). Independent analysis, not affiliated with Prasarana or Rapid KL.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "7pt",
                      "color": "#5B6475"
                    }
                  }
                ]
              }
            ]
