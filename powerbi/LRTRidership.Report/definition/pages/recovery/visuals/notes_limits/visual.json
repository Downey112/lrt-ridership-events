                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#101828"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "School holidays for 2022–26 come from unofficial calendars (data/school_holidays.csv).",
