                ]
              },
              {
                "textRuns": [
                  {
                    "value": "LRT Shah Alam lost about 4 in 10 weekday riders once fares started (55k free → 34k paid), the 2022 free month in reverse.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#101828"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Its opening did not measurably move the older lines: Kelana Jaya +12% and MRT Kajang +10% in its first seven weeks, both inside the ±15% noise for a forecast that long.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#101828"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Only seven weeks of LRT Shah Alam data so far (to 31 Aug 2026); paid ridership may still be settling.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#5B6475"
                    }
