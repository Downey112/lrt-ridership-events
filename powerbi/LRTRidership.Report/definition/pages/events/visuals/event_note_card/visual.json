{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.3.0/schema.json",
  "name": "event_note_card",
  "position": {
    "x": 700,
    "y": 96,
    "z": 6000,
    "height": 56,
    "width": 556,
    "tabOrder": 6000
  },
  "visual": {
    "visualType": "card",
    "query": {
      "queryState": {
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "event_effects"
                    }
                  },
                  "Property": "Event Note"
                }
              },
              "queryRef": "event_effects.Event Note",
              "nativeQueryRef": "Event Note"
            }
          ]
        }
      }
    },
    "objects": {
      "labels": [
        {
          "properties": {
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "10D"
                }
              }
            },
            "color": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#5B6475'"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "background": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ],
      "general": [
        {
          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'Note on the selected event.'"
                }
              }
            }
          }
        }
      ],
      "padding": [
        {
          "properties": {
            "top": {
              "expr": {
                "Literal": {
                  "Value": "4D"
                }
              }
            },
            "bottom": {
              "expr": {
                "Literal": {
                  "Value": "4D"
                }
              }
            },
            "left": {
              "expr": {
                "Literal": {
                  "Value": "12D"
                }
              }
            },
            "right": {
              "expr": {
                "Literal": {
                  "Value": "12D"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
